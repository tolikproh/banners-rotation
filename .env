POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=banners
BANNERS_HTTP_SERVER_HOST=0.0.0.0
BANNERS_HTTP_SERVER_PORT=8000
BANNERS_LOG_LEVEL=info
BANNERS_STORAGE_CONN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pg:5432/${POSTGRES_DB}?sslmode=disable
BANNERS_RABBITMQ_ADDRESS=amqp://guest:guest@rabbit:5672
BANNERS_RABBITMQ_EXCHANGE=banners-rotation
BANNERS_RABBITMQ_QUEUE=banners-rotation
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5417/${POSTGRES_DB}?sslmode=disable
